<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.dictado" path="/org/gnome/shell/extensions/dictado/">
    <key name="dictation-shortcut" type="as">
      <default><![CDATA[['<Super>j']]]></default>
      <summary>Dictation shortcut</summary>
      <description>Hold = talk while held; quick tap = start/stop.</description>
    </key>
    <key name="transcription-shortcut" type="as">
      <default><![CDATA[['<Super><Shift>j']]]></default>
      <summary>Live transcript shortcut</summary>
    </key>
    <key name="hold-threshold" type="i">
      <default>350</default>
      <summary>Milliseconds after which the shortcut counts as held</summary>
    </key>
    <key name="insert-method" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="input-method"/>
        <choice value="paste"/>
      </choices>
      <default>'auto'</default>
      <summary>How to insert the text</summary>
      <description>auto: the input method when the app supports it, otherwise clipboard + Ctrl+V.</description>
    </key>
    <key name="restore-clipboard" type="b">
      <default>true</default>
      <summary>Restore the clipboard after pasting</summary>
    </key>
    <key name="append-space" type="b">
      <default>true</default>
      <summary>Add a space after each dictation</summary>
    </key>
    <key name="show-indicator" type="b">
      <default>true</default>
      <summary>Show the icon in the top bar</summary>
    </key>
  </schema>
</schemalist>
