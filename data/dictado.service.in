[Unit]
Description=Dictado: local voice dictation and transcription (Whisper)
PartOf=graphical-session.target
After=graphical-session.target pipewire.service

[Service]
Type=dbus
BusName=dev.dictado.Dictado
ExecStart=@BIN@ serve
Restart=on-failure
# Whisper uses all the CPU it can get: keep the desktop smooth.
Nice=5

[Install]
WantedBy=graphical-session.target
