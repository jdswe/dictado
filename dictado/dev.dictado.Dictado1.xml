<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Dictado's API on the session bus.
  Name: dev.dictado.Dictado   Object: /dev/dictado/Dictado
  The service starts by itself (D-Bus activation) when any method is called.

  Dictation states:       idle | recording | processing
  Transcription states:   idle | recording
-->
<node>
  <interface name="dev.dictado.Dictado1">
    <!-- Dictation (microphone only). DictationText is emitted when done. -->
    <method name="StartDictation"/>
    <method name="StopDictation"/>
    <method name="CancelDictation"/>
    <method name="Toggle"/>

    <!-- Live transcription (microphone + system audio). -->
    <method name="StartTranscription">
      <arg type="s" name="path" direction="out"/>
    </method>
    <method name="StopTranscription">
      <arg type="s" name="path" direction="out"/>
    </method>
    <method name="ToggleTranscription"/>

    <!-- Transcribe an audio/video file in the background. Returns the path
         of the .txt that will be written; FileDone signals completion. -->
    <method name="TranscribeFile">
      <arg type="s" name="path" direction="in"/>
      <arg type="s" name="output" direction="out"/>
    </method>

    <method name="GetStatus">
      <arg type="a{sv}" name="status" direction="out"/>
    </method>
    <method name="Quit"/>

    <property name="Dictation" type="s" access="read"/>
    <property name="Transcription" type="s" access="read"/>
    <property name="TranscriptPath" type="s" access="read"/>
    <property name="TranscriptionStarted" type="x" access="read"/>
    <property name="ModelReady" type="b" access="read"/>

    <!-- dictation, transcription -->
    <signal name="StateChanged">
      <arg type="s" name="dictation"/>
      <arg type="s" name="transcription"/>
    </signal>
    <!-- Final dictation text, to be typed at the cursor. -->
    <signal name="DictationText">
      <arg type="s" name="text"/>
      <arg type="s" name="language"/>
    </signal>
    <!-- Microphone level 0..1 while dictating (~10 times/s). -->
    <signal name="Level">
      <arg type="d" name="level"/>
    </signal>
    <!-- Each new live transcript line. time = unix ms. -->
    <signal name="TranscriptLine">
      <arg type="s" name="speaker"/>
      <arg type="s" name="text"/>
      <arg type="x" name="time"/>
    </signal>
    <signal name="FileProgress">
      <arg type="s" name="path"/>
      <arg type="d" name="fraction"/>
    </signal>
    <signal name="FileDone">
      <arg type="s" name="path"/>
      <arg type="s" name="output"/>
    </signal>
    <signal name="Error">
      <arg type="s" name="message"/>
    </signal>
  </interface>
</node>
